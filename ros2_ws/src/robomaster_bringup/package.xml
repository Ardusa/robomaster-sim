<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>robomaster_bringup</name>
    <version>0.0.1</version>
    <description>Composition-only entry point for the RoboMaster EP.

        Starts description plus whichever subsystems you ask for: drivetrain,
        camera, detection, and exactly one backend (gazebo or driver). Does not
        implement motion, muxing, or teleop — those live in robomaster_drivetrain
        and robomaster_teleop.
    </description>
    <maintainer email="ardusa05@gmail.com">Ankur</maintainer>
    <license>MIT</license>

    <buildtool_depend>ament_cmake</buildtool_depend>

    <!-- bringup.launch.py includes whichever backend SIM names, so it depends on
         both. The backends do not depend on each other. -->
    <exec_depend>robomaster_description</exec_depend>
    <exec_depend>robomaster_drivetrain</exec_depend>
    <exec_depend>robomaster_teleop</exec_depend>
    <exec_depend>robomaster_gazebo</exec_depend>
    <exec_depend>robomaster_driver</exec_depend>
    <exec_depend>robomaster_camera</exec_depend>
    <exec_depend>robomaster_detection</exec_depend>
    <exec_depend>launch</exec_depend>
    <exec_depend>launch_ros</exec_depend>
    <exec_depend>robot_state_publisher</exec_depend>
    <exec_depend>joint_state_publisher</exec_depend>
    <exec_depend>web_video_server</exec_depend>
    <exec_depend>xacro</exec_depend>

    <test_depend>ament_lint_auto</test_depend>
    <test_depend>ament_lint_common</test_depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>
