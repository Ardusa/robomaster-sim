        <geometry>
          <mesh filename="package://robomaster_description/meshes/right_servo.dae"
            scale="1.0 1.0 1.0" />
        </geometry>
        <material name="metal" />
      </visual>
      <collision name="arm_base_collision">
        <origin xyz="-0.002098 -0.0004909 0.0073523" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://robomaster_description/meshes/arm_base_collision.dae"
            scale="1.0 1.0 1.0" />
        </geometry>
      </collision>
    </link>

    <!-- Geometryless frames get a nominal point-mass inertia: small enough not
         to perturb the body they weld into, large enough to stay positive
         definite. -->
    <link name="${tf_prefix}end_point_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="0.001" />
        <inertia ixx="1e-09" ixy="0" ixz="0" iyy="1e-09" iyz="0" izz="1e-09" />
      </inertial>
    </link>

    <link name="${tf_prefix}endpoint_bracket_link">
      <inertial>
        <origin xyz="0.0117106 -0.03068662 -0.002782978" rpy="0 0 0" />
        <mass value="0.028" />
        <inertia ixx="1.31087e-05" ixy="3.88132e-07" ixz="-4.6124e-07" iyy="6.63736e-06"
          iyz="2.12334e-06" izz="1.36971e-05" />
      </inertial>
      <visual name="endpoint_bracket">
        <origin xyz="0.0071657 -0.0245846 0.0008407" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://robomaster_description/meshes/endpoint_bracket.dae"
