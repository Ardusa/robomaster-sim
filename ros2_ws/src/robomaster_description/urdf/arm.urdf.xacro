<?xml version="1.0"?>
<robot xmlns:xacro="http://playerstage.sourceforge.net/gazebo/xmlschema/#xacro">

  <!-- The EP arm is two parallelogram linkages: three servo axes (arm_1_joint,
       rod_joint, rod_3_joint) plus five bars whose angles are fixed by loop
       closures. URDF is a kinematic tree and cannot express a closed loop, so
       this description used to declare the bars as free joints tagged <mimic>.
       <mimic> is not a constraint, only a hint that joint_state_publisher and
       recent ros2_control read, and SDFormat 12 drops it outright: Gazebo
       Fortress therefore saw eight unconstrained frictionless zero-effort
       hinges, and gravity swung them indefinitely.

       Fortress cannot express the constraint by any other route either, since
       gz-physics' DART backend has no closed-chain support and mimic joints
       only arrived in SDFormat 14 / Gazebo Harmonic. So every joint whose value
       is determined by a loop closure is welded here instead. At zero the CAD
       assembly pose is exactly consistent, so the welded result is the correct
       assembled shape; it has no degrees of freedom left to drift, and it
       behaves identically on every solver, physics engine and machine.
       robot_state_publisher still publishes all of these frames.

       Nothing in this stack actuates the arm anyway: ros2_control drives the
       four wheels only. Articulating it needs a simulator that can close the
       loops, or a description rebuilt around one serial chain per parallelogram.
       Nominal servo ranges, kept for whoever does that: arm_1_joint
       [-0.274, 1.384], rod_joint [-0.799, 1.731], rod_3_joint [-0.347, 1.215] rad.

       Every inertia below is computed from the link's collision mesh by
       scripts/mesh_inertia.py; edit scripts/inertia_manifest.txt and rerun it
       rather than hand-editing these numbers. -->

  <xacro:macro name="arm" params="tf_prefix=''">

    <link name="${tf_prefix}arm_1_link">
      <inertial>
        <origin xyz="0.01205666 0.02230166 0.05887051" rpy="0 0 0" />
        <mass value="0.056" />
        <inertia ixx="8.49512e-05" ixy="-3.95594e-07" ixz="-2.11241e-06" iyy="6.62308e-05"
          iyz="-1.5812e-06" izz="2.53281e-05" />
      </inertial>
      <visual name="arm_1">
        <origin xyz="0.0073108 0.0184816 0.0437162" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://robomaster_description/meshes/arm_1.dae" scale="1.0 1.0 1.0" />
        </geometry>
        <material name="metal" />
      </visual>
      <visual name="arm_1_cylinder">
        <origin xyz="-0.0239031 0.0255713 -0.0368083" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://robomaster_description/meshes/arm_1_cylinder.dae"
            scale="1.0 1.0 1.0" />
        </geometry>
        <material name="metal" />
      </visual>
      <collision name="arm_1_collision">
        <origin xyz="0.0065116 0.0213649 0.0639448" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://robomaster_description/meshes/arm_1_collision.dae"
            scale="1.0 1.0 1.0" />
        </geometry>
      </collision>
    </link>

    <!-- <link name="arm_2_dummy">
    </link> -->

    <link name="${tf_prefix}arm_2_link">
      <inertial>
        <origin xyz="0.03671166 -0.02033782 0.00391168" rpy="0 0 0" />
        <mass value="0.08" />
        <inertia ixx="6.08608e-05" ixy="-6.10762e-08" ixz="6.09701e-05" iyy="0.000165693"
          iyz="3.71217e-08" izz="0.000151413" />
      </inertial>
      <visual name="arm_2">
        <origin xyz="0.0256122 -0.020134 -0.001308" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://robomaster_description/meshes/arm_2.dae" scale="1.0 1.0 1.0" />
        </geometry>
        <!-- <material name="metal"/> -->
        <material name="Test">
          <color rgba="0.0 0.0 0.0 1.0" />
        </material>
      </visual>
      <visual name="arm_2_bar_1">
        <origin xyz="7.62e-05 0.0010863 -0.0002509" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://robomaster_description/meshes/arm_2_bar_1.dae"
            scale="1.0 1.0 1.0" />
        </geometry>
        <material name="metal" />
      </visual>
      <visual name="arm_2_bar_2">
        <origin xyz="-0.0423232 -0.0099192 0.0221971" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://robomaster_description/meshes/arm_2_bar_2.dae"
            scale="1.0 1.0 1.0" />
        </geometry>
        <material name="metal" />
      </visual>
      <collision name="arm_2_collision">
