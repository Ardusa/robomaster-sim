        <origin xyz="-0.04802565 0 0.03246364" rpy="0 0 0" />
        <mass value="0.012" />
        <inertia ixx="4.97769e-06" ixy="0" ixz="8.37868e-06" iyy="2.02607e-05" iyz="0"
          izz="1.53005e-05" />
      </inertial>
      <visual name="rod_1">
        <origin xyz="-0.0479737 0 0.0301898" rpy="0 0 0" />
        <geometry>
