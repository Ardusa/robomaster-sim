        <inertia ixx="1.3148e-06" ixy="0" ixz="1.84731e-06" iyy="5.21407e-06" iyz="0"
          izz="3.97845e-06" />
      </inertial>
      <visual name="rod">
        <origin xyz="-0.0261857 0.0022566 0.0121229" rpy="0 0 0" />
