    <!-- <link name="triangle_1_dummy">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.001"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link> -->

    <!-- <link name="triangle_2_dummy">
    </link> -->

    <link name="${tf_prefix}triangle_link">
      <inertial>
        <origin xyz="-0.01120213 0 0.0129844" rpy="0 0 0" />
        <mass value="0.009" />
        <inertia ixx="6.19224e-07" ixy="0" ixz="-1.62891e-08" iyy="2.7415e-06" iyz="0"
          izz="2.13638e-06" />
      </inertial>
      <visual name="triangle">
        <origin xyz="-0.0095953 0 0.0131247" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://robomaster_description/meshes/triangle.dae" scale="1.0 1.0 1.0" />
