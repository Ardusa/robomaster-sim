        <geometry>
          <mesh filename="package://robomaster_description/meshes/arm_2_collision.dae"
            scale="1.0 1.0 1.0" />
        </geometry>
      </collision>
    </link>

    <!-- <link name="arm_base_attachment_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.001"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link> -->

    <link name="${tf_prefix}arm_base_link">
      <inertial>
        <origin xyz="-0.001910214 -0.001483998 0.02477027" rpy="0 0 0" />
        <mass value="0.3" />
        <inertia ixx="0.000694227" ixy="2.66773e-07" ixz="-8.3416e-07" iyy="0.000216367"
          iyz="2.73943e-06" izz="0.000757545" />
      </inertial>
      <visual name="arm_base">
        <origin xyz="-0.0008983 -0.0029745 -2.44e-05" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://robomaster_description/meshes/arm_base.dae" scale="1.0 1.0 1.0" />
        </geometry>
        <material name="metal" />
      </visual>
      <visual name="left_servo">
        <origin xyz="-0.013507 0 -0.0060673" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://robomaster_description/meshes/left_servo.dae"
            scale="1.0 1.0 1.0" />
        </geometry>
        <material name="metal" />
      </visual>
      <visual name="right_servo">
