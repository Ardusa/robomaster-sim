<?xml version="1.0"?>

<robot xmlns:xacro="http://playerstage.sourceforge.net/gazebo/xmlschema/#xacro">

  <!-- Each finger is a five-bar loop driven by the gripper_m_joint slider: the
       chain gripper_m -> _1 -> _2 -> _4 -> _5 -> _6 -> _7 closes back onto
       gripper_m through the link the commented-out *_joint_8_dummy blocks below
       stood in for. URDF cannot express that closure, so the chain used to be
       twelve free hinges with zero effort and no damping, which gravity swung
       indefinitely, and the loose ends were free to pass through the fingers.

       As in arm.urdf.xacro, the whole assembly is welded: Gazebo Fortress has no
       way to represent a closed chain (no mimic before SDFormat 14, no
       closed-chain support in the DART backend), the zero pose is the consistent
       CAD assembly pose, and welding leaves nothing that can drift or diverge
       between machines. The gripper is not actuated here either; ros2_control
       drives the four wheels only. Slider travel, kept for reference:
       gripper_m_joint [-0.023, 0.001] m along -x.

       Inertias are computed by scripts/mesh_inertia.py from each link's
       collision mesh, or its visual mesh where it has no collision geometry.
       Edit scripts/inertia_manifest.txt and rerun rather than editing these. -->

  <xacro:macro name="gripper" params="tf_prefix=''">

    <link name="${tf_prefix}left_gripper_link_1">
      <inertial>
        <origin xyz="0.01029408 0.007220001 9.004375e-05" rpy="0 0 0" />
        <mass value="0.001" />
        <inertia ixx="5.91414e-08" ixy="-4.22033e-08" ixz="8.43934e-10" iyy="1.06563e-07"
          iyz="-1.25763e-09" izz="1.08961e-07" />
      </inertial>
      <visual name="left_gripper_1">
        <origin xyz="-1.52e-05 8.12e-05 -2.25e-05" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://robomaster_description/meshes/gripper_left_1.dae"
            scale="1.0 1.0 1.0" />
        </geometry>
        <material name="EP_up.001" />
      </visual>
    </link>

    <link name="${tf_prefix}left_gripper_link_2">
      <inertial>
        <origin xyz="0.006233221 0.006162566 9.246498e-05" rpy="0 0 0" />
        <mass value="0.001" />
        <inertia ixx="9.3765e-08" ixy="8.50684e-09" ixz="0" iyy="5.07145e-08" iyz="0"
          izz="1.05659e-07" />
      </inertial>
      <visual name="left_gripper_2">
        <origin xyz="0.0135565 -0.0033557 -2.25e-05" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://robomaster_description/meshes/gripper_left_2.dae"
            scale="1.0 1.0 1.0" />
        </geometry>
        <material name="EP_up.001" />
      </visual>
      <collision name="left_gripper_2_collision">
        <origin xyz="0.0136108 -0.003318 -0.0296613" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://robomaster_description/meshes/gripper_left_2_collision.dae"
            scale="1.0 1.0 1.0" />
        </geometry>
      </collision>
    </link>

