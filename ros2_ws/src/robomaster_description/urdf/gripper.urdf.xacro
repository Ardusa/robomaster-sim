    </link>

    <!-- Geometryless frames get a nominal point-mass inertia: small enough not
         to perturb the body they weld into, large enough to stay positive
         definite. -->
    <link name="${tf_prefix}gripper_m_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="0.001" />
        <inertia ixx="1e-09" ixy="0" ixz="0" iyy="1e-09" iyz="0" izz="1e-09" />
      </inertial>
    </link>

    <link name="${tf_prefix}gripper_t_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="0.001" />
        <inertia ixx="1e-09" ixy="0" ixz="0" iyy="1e-09" iyz="0" izz="1e-09" />
      </inertial>
    </link>

    <!-- Slider that drives both fingers; welded with the loops it closes. -->
    <joint name="${tf_prefix}gripper_m_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <parent link="${tf_prefix}gripper_link" />
      <child link="${tf_prefix}gripper_m_link" />
    </joint>


