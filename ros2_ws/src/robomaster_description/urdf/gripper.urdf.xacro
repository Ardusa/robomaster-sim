<?xml version="1.0"?>
<robot xmlns:xacro="http://playerstage.sourceforge.net/gazebo/xmlschema/#xacro">

  <!-- Parallel-jaw approximation of the EP gripper. Proximal finger meshes stay
       welded at the CAD pose on gripper_link; only the tips (link 7) ride
       opposing prismatic joints along ±Y. Both joints take the same command
       value (axes are opposite). Limits stay [-0.023, 0.001]. -->

  <xacro:macro name="gripper" params="tf_prefix=''">

    <link name="${tf_prefix}gripper_link">
      <inertial>
        <origin xyz="0.03145979 -0.0003026102 -0.03000667" rpy="0 0 0" />
        <mass value="0.15" />
        <inertia ixx="9.38273e-05" ixy="-5.32148e-07" ixz="4.93264e-06" iyy="8.75542e-05"
          iyz="1.52057e-06" izz="0.000128853" />
      </inertial>
      <visual name="gripper_base">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://robomaster_description/meshes/gripper_base.dae"
            scale="1.0 1.0 1.0" />
        </geometry>
        <material name="EP_up.001" />
      </visual>
      <collision name="gripper_base_collision">
        <origin xyz="0.0003688 -9.78e-05 -0.0112797" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://robomaster_description/meshes/gripper_base_collision.dae"
            scale="1.0 1.0 1.0" />
        </geometry>
      </collision>
      <!-- Proximal left finger (fixed CAD pose). -->
      <visual name="left_gripper_1">
        <origin xyz="0.016288 0.0212844 -0.0399426" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://robomaster_description/meshes/gripper_left_1.dae"
            scale="1.0 1.0 1.0" />
        </geometry>
        <material name="EP_up.001" />
      </visual>
      <visual name="left_gripper_2">
        <origin xyz="0.0512092 0.0308838 -0.0399426" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://robomaster_description/meshes/gripper_left_2.dae"
            scale="1.0 1.0 1.0" />
        </geometry>
        <material name="EP_up.001" />
      </visual>
      <visual name="left_gripper_4">
        <origin xyz="0.0424553 0.054828 -0.0399426" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://robomaster_description/meshes/gripper_left_4.dae"
            scale="1.0 1.0 1.0" />
        </geometry>
        <material name="EP_up.001" />
      </visual>
      <visual name="left_gripper_5">
        <origin xyz="0.0810217 0.0649668 -0.0399426" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://robomaster_description/meshes/gripper_left_5.dae"
            scale="1.0 1.0 1.0" />
        </geometry>
        <material name="EP_up.001" />
      </visual>
      <visual name="left_gripper_6">
        <origin xyz="0.0712893 0.0340313 -0.0399426" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://robomaster_description/meshes/gripper_left_6.dae"
            scale="1.0 1.0 1.0" />
        </geometry>
        <material name="EP_up.001" />
      </visual>
      <!-- Proximal right finger (fixed CAD pose). -->
      <visual name="right_gripper_1">
        <origin xyz="0.0162882 -0.0210593 -0.0399426" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://robomaster_description/meshes/right_gripper_1.dae"
            scale="1.0 1.0 1.0" />
        </geometry>
        <material name="EP_up.001" />
      </visual>
      <visual name="right_gripper_2">
        <origin xyz="0.0503628 -0.0319088 -0.0399426" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://robomaster_description/meshes/right_gripper_2.dae"
            scale="1.0 1.0 1.0" />
        </geometry>
        <material name="EP_up.001" />
      </visual>
      <visual name="right_gripper_4">
        <origin xyz="0.0423206 -0.0550362 -0.0399426" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://robomaster_description/meshes/right_gripper_4.dae"
            scale="1.0 1.0 1.0" />
        </geometry>
        <material name="EP_up.001" />
      </visual>
      <visual name="right_gripper_5">
        <origin xyz="0.080887 -0.0651751 -0.0399426" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://robomaster_description/meshes/right_gripper_5.dae"
            scale="1.0 1.0 1.0" />
        </geometry>
        <material name="EP_up.001" />
      </visual>
      <visual name="right_gripper_6">
        <origin xyz="0.0558574 -0.0180441 -0.0399426" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://robomaster_description/meshes/right_gripper_6.dae"
            scale="1.0 1.0 1.0" />
        </geometry>
        <material name="EP_up.001" />
      </visual>
    </link>

    <!-- Left tip (+Y). -->
    <link name="${tf_prefix}gripper_m_link">
      <inertial>
        <origin xyz="0.056 0.0174 -0.04" rpy="0 0 0" />
        <mass value="0.01" />
        <inertia ixx="1e-06" ixy="0" ixz="0" iyy="1e-06" iyz="0" izz="1e-06" />
      </inertial>
      <visual name="left_gripper_7">
        <origin xyz="0.056 0.0174005 -0.0399426" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://robomaster_description/meshes/gripper_left_7.dae"
            scale="1.0 1.0 1.0" />
        </geometry>
        <material name="EP_up.001" />
      </visual>
      <collision name="left_gripper_collision">
        <origin xyz="0.0564138 0.0172595 -0.0695631" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://robomaster_description/meshes/gripper_left_collision.dae"
            scale="1.0 1.0 1.0" />
        </geometry>
      </collision>
    </link>

    <!-- Right tip (−Y via opposite joint axis). -->
    <link name="${tf_prefix}gripper_r_link">
      <inertial>
        <origin xyz="0.056 -0.0174 -0.04" rpy="0 0 0" />
        <mass value="0.01" />
        <inertia ixx="1e-06" ixy="0" ixz="0" iyy="1e-06" iyz="0" izz="1e-06" />
      </inertial>
      <visual name="right_gripper_7">
        <origin xyz="0.0711547 -0.0342395 -0.0399426" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://robomaster_description/meshes/right_gripper_7.dae"
            scale="1.0 1.0 1.0" />
        </geometry>
        <material name="EP_up.001" />
      </visual>
      <collision name="right_gripper_7_collision">
        <origin xyz="0.0561863 -0.0173908 -0.0695631" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://robomaster_description/meshes/right_gripper_7_collision.dae"
            scale="1.0 1.0 1.0" />
        </geometry>
      </collision>
    </link>

    <link name="${tf_prefix}gripper_t_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="0.001" />
        <inertia ixx="1e-09" ixy="0" ixz="0" iyy="1e-09" iyz="0" izz="1e-09" />
      </inertial>
    </link>

    <joint name="${tf_prefix}gripper_joint" type="fixed">
      <origin xyz="0.0002793 -0.027026 0.0001815" rpy="0 0 0" />
      <parent link="${tf_prefix}endpoint_bracket_link" />
      <child link="${tf_prefix}gripper_link" />
    </joint>

    <joint name="${tf_prefix}gripper_m_joint" type="prismatic">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <parent link="${tf_prefix}gripper_link" />
      <child link="${tf_prefix}gripper_m_link" />
      <axis xyz="0 1 0" />
      <limit lower="-0.023" upper="0.001" effort="40.0" velocity="0.08" />
      <dynamics damping="0.05" friction="0.0" />
    </joint>

    <joint name="${tf_prefix}gripper_r_joint" type="prismatic">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <parent link="${tf_prefix}gripper_link" />
      <child link="${tf_prefix}gripper_r_link" />
      <axis xyz="0 -1 0" />
      <limit lower="-0.023" upper="0.001" effort="40.0" velocity="0.08" />
      <dynamics damping="0.05" friction="0.0" />
    </joint>

    <joint name="${tf_prefix}gripper_joint_t" type="fixed">
      <origin xyz="0.124 0 -0.039" rpy="0 0 0" />
      <parent link="${tf_prefix}gripper_link" />
      <child link="${tf_prefix}gripper_t_link" />
    </joint>

  </xacro:macro>
</robot>
