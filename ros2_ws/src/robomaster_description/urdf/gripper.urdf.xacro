          <child link="right_gripper_link_8_dummy"/>
        </joint> -->

    <joint name="${tf_prefix}gripper_joint_t" type="fixed">
      <origin xyz="0.124 0 -0.039" rpy="0 0 0" />
      <parent link="${tf_prefix}gripper_link" />
      <child link="${tf_prefix}gripper_t_link" />
    </joint>

  </xacro:macro>
</robot>
