<?xml version="1.0"?>
<!--
  The robot's <ros2_control> block, in both flavours. Mutually exclusive:
  emitting both makes controller_manager fight over the same joint names.

  Lives here rather than in robomaster_tether because the plugin is named as a
  string (pluginlib resolves it at runtime), so this costs no dependency —
  whereas the reverse would make description depend on tether.

  Sim exposes wheels + serial arm + gripper. Tether exposes wheels only; the
  physical arm is driven through the SDK on the same TCP session the hardware
  interface owns (see robomaster_tether / robomaster_arm).
-->
<robot xmlns:xacro="http://playerstage.sourceforge.net/gazebo/xmlschema/#xacro">

  <xacro:macro name="wheel_ros2_control_joints" params="tf_prefix=''">
    <joint name="${tf_prefix}front_right_wheel_joint">
      <command_interface name="velocity" />
      <state_interface name="velocity" />
      <state_interface name="position" />
    </joint>
    <joint name="${tf_prefix}front_left_wheel_joint">
      <command_interface name="velocity" />
      <state_interface name="velocity" />
      <state_interface name="position" />
    </joint>
    <joint name="${tf_prefix}rear_right_wheel_joint">
      <command_interface name="velocity" />
      <state_interface name="velocity" />
      <state_interface name="position" />
    </joint>
    <joint name="${tf_prefix}rear_left_wheel_joint">
      <command_interface name="velocity" />
      <state_interface name="velocity" />
      <state_interface name="position" />
    </joint>
  </xacro:macro>

  <xacro:macro name="arm_ros2_control_joints" params="tf_prefix=''">
    <joint name="${tf_prefix}arm_1_joint">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="${tf_prefix}arm_2_joint">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="${tf_prefix}gripper_m_joint">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="${tf_prefix}gripper_r_joint">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
  </xacro:macro>

  <xacro:macro name="ros2_control"
    params="sim:=false tf_prefix='' robot_ip:=''
            control_port:=40923 wheel_radius_m:=0.05
            sim_controllers_file:=''">

    <xacro:unless value="${sim}">
      <ros2_control name="RobomasterSystem" type="system">
        <hardware>
          <plugin>robomaster_tether/HardwareInterface</plugin>
          <param name="robot_ip">${robot_ip}</param>
          <param name="control_port">${control_port}</param>
          <param name="wheel_radius_m">${wheel_radius_m}</param>
        </hardware>
        <xacro:wheel_ros2_control_joints tf_prefix="${tf_prefix}" />
      </ros2_control>
    </xacro:unless>

    <xacro:if value="${sim}">
      <ros2_control name="RobomasterSimSystem" type="system">
        <hardware>
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
        <xacro:wheel_ros2_control_joints tf_prefix="${tf_prefix}" />
        <xacro:arm_ros2_control_joints tf_prefix="${tf_prefix}" />
      </ros2_control>

      <gazebo>
        <plugin filename="gz_ros2_control-system"
          name="gz_ros2_control::GazeboSimROS2ControlPlugin">
          <parameters>${sim_controllers_file}</parameters>
        </plugin>
      </gazebo>
    </xacro:if>

  </xacro:macro>

</robot>
