<?xml version="1.0"?>
<robot xmlns:xacro="http://playerstage.sourceforge.net/gazebo/xmlschema/#xacro">

  <!-- 2D lidar for sim Nav2. Mounted on base_link, 15 cm above ground contact. -->
  <xacro:macro name="lidar" params="tf_prefix='' sim:=false">
    <link name="${tf_prefix}laser_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="0.01" />
        <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5" />
      </inertial>
    </link>

    <joint name="${tf_prefix}laser_joint" type="fixed">
      <origin xyz="0 0 0.15" rpy="0 0 0" />
      <parent link="${tf_prefix}base_link" />
      <child link="${tf_prefix}laser_link" />
    </joint>

    <xacro:if value="${sim}">
      <gazebo reference="${tf_prefix}laser_link">
        <sensor name="lidar" type="gpu_lidar">
          <topic>scan</topic>
          <update_rate>10</update_rate>
          <lidar>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.12</min>
              <max>8.0</max>
              <resolution>0.01</resolution>
            </range>
          </lidar>
          <always_on>true</always_on>
          <visualize>false</visualize>
          <gz_frame_id>${tf_prefix}laser_link</gz_frame_id>
        </sensor>
      </gazebo>
    </xacro:if>
  </xacro:macro>

</robot>
