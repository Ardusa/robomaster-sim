<?xml version="1.0"?>
<sdf version="1.9">
  <world name="modern_house">
    <!-- Same system set as robot_only.sdf: Sensors is not in Gazebo's
         implicit defaults, so without it the robot camera never publishes. -->
    <plugin filename="ignition-gazebo-physics-system"
            name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="ignition-gazebo-sensors-system"
            name="gz::sim::systems::Sensors">
    </plugin>
    <plugin filename="ignition-gazebo-contact-system"
            name="gz::sim::systems::Contact">
    </plugin>

    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <gravity>0 0 -9.81</gravity>
    <scene>
      <ambient>0.32 0.34 0.38 1</ambient>
      <background>0.62 0.70 0.80 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- No <gui> block on purpose. Fortress ignores the classic
         <gui><camera> pose, and a MinimalScene plugin here would set the
         viewpoint but replace Gazebo's whole default GUI with itself, taking the
         entity tree and the play/pause controls with it. sim.launch.py sets the
         opening viewpoint through Gazebo's gui-config option instead. -->

    <light name="sun" type="directional">
      <pose>0 0 12 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.75 0.78 0.84 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <light name="living_room_light" type="point">
      <pose>4 0.8 2.25 0 0 0</pose>
      <diffuse>1.0 0.82 0.62 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <attenuation>
        <range>9</range>
        <constant>0.7</constant>
        <linear>0.08</linear>
        <quadratic>0.02</quadratic>
      </attenuation>
      <cast_shadows>true</cast_shadows>
    </light>

    <light name="kitchen_light" type="point">
      <pose>4.8 3.8 2.25 0 0 0</pose>
      <diffuse>0.92 0.94 1.0 1</diffuse>
      <specular>0.12 0.12 0.12 1</specular>
      <attenuation>
        <range>8</range>
        <constant>0.75</constant>
        <linear>0.08</linear>
        <quadratic>0.02</quadratic>
      </attenuation>
    </light>

    <light name="north_bedroom_light" type="point">
      <pose>-4.2 2.6 2.25 0 0 0</pose>
      <diffuse>1.0 0.86 0.70 1</diffuse>
      <attenuation>
        <range>7</range>
        <constant>0.8</constant>
        <linear>0.08</linear>
        <quadratic>0.02</quadratic>
      </attenuation>
    </light>

    <light name="south_bedroom_light" type="point">
      <pose>-4.2 -2.6 2.25 0 0 0</pose>
      <diffuse>1.0 0.86 0.70 1</diffuse>
      <attenuation>
        <range>7</range>
        <constant>0.8</constant>
        <linear>0.08</linear>
        <quadratic>0.02</quadratic>
      </attenuation>
    </light>

    <!-- The architectural shell uses static primitive geometry. It has no
         inertial blocks because it never participates as a dynamic body. -->
    <!-- Where sim.launch.py drops the robot: on the entry apron outside the
         south doorway, centred on the 1.8 m opening between wall_south_west
         (x<=-0.9) and wall_south_east (x>=0.9), yawed +90 deg so the chassis
         and camera face north through the door into the hall. The origin is not
         usable here: the hall console's cabinet sits across it. -->
    <frame name="robot_spawn">
      <pose>0 -6.2 0.1 0 0 1.5708</pose>
    </frame>

    <model name="house_shell">
      <static>true</static>

      <!-- The slab runs 3 m past the south wall so the entry apron is part of
           the same collision box as the interior floor. A separate apron slab
           butted against this one would put a coplanar contact seam directly in
           the doorway, which the wheels have to cross on every run. -->
      <link name="floor">
        <pose>0 -1.5 -0.06 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>14 13 0.12</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>14 13 0.12</size></box></geometry>
          <material>
            <ambient>0.34 0.31 0.27 1</ambient>
            <diffuse>0.42 0.37 0.31 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
          </material>
        </visual>
      </link>

      <!-- Exterior: the south wall leaves a two-metre entry opening. -->
      <link name="wall_north">
        <pose>0 5 1.3 0 0 0</pose>
        <collision name="collision"><geometry><box><size>14.2 0.16 2.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>14.2 0.16 2.6</size></box></geometry>
          <material><ambient>0.78 0.77 0.73 1</ambient><diffuse>0.88 0.86 0.80 1</diffuse></material>
        </visual>
      </link>
      <link name="wall_south_west">
        <pose>-4 -5 1.3 0 0 0</pose>
        <collision name="collision"><geometry><box><size>6.2 0.16 2.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6.2 0.16 2.6</size></box></geometry>
          <material><ambient>0.78 0.77 0.73 1</ambient><diffuse>0.88 0.86 0.80 1</diffuse></material>
        </visual>
      </link>
      <link name="wall_south_east">
        <pose>4 -5 1.3 0 0 0</pose>
        <collision name="collision"><geometry><box><size>6.2 0.16 2.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6.2 0.16 2.6</size></box></geometry>
          <material><ambient>0.78 0.77 0.73 1</ambient><diffuse>0.88 0.86 0.80 1</diffuse></material>
        </visual>
      </link>
      <link name="wall_east">
        <pose>7 0 1.3 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.16 10 2.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.16 10 2.6</size></box></geometry>
          <material><ambient>0.78 0.77 0.73 1</ambient><diffuse>0.88 0.86 0.80 1</diffuse></material>
        </visual>
      </link>
      <link name="wall_west">
        <pose>-7 0 1.3 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.16 10 2.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.16 10 2.6</size></box></geometry>
          <material><ambient>0.78 0.77 0.73 1</ambient><diffuse>0.88 0.86 0.80 1</diffuse></material>
        </visual>
      </link>

      <!-- West bedroom wing / central hall, with two door openings. -->
      <link name="hall_west_south">
        <pose>-1 -3.85 1.3 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.14 2.3 2.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.14 2.3 2.6</size></box></geometry>
          <material><ambient>0.68 0.72 0.74 1</ambient><diffuse>0.76 0.80 0.81 1</diffuse></material>
        </visual>
      </link>
      <link name="hall_west_center">
        <pose>-1 0 1.3 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.14 2.0 2.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.14 2.0 2.6</size></box></geometry>
          <material><ambient>0.68 0.72 0.74 1</ambient><diffuse>0.76 0.80 0.81 1</diffuse></material>
        </visual>
      </link>
      <link name="hall_west_north">
        <pose>-1 3.85 1.3 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.14 2.3 2.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.14 2.3 2.6</size></box></geometry>
          <material><ambient>0.68 0.72 0.74 1</ambient><diffuse>0.76 0.80 0.81 1</diffuse></material>
        </visual>
      </link>

      <!-- Bedroom divider with a doorway near the west wall. -->
      <link name="bedroom_divider_east">
        <pose>-2.9 0 1.3 0 0 0</pose>
        <collision name="collision"><geometry><box><size>3.8 0.14 2.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>3.8 0.14 2.6</size></box></geometry>
          <material><ambient>0.72 0.69 0.65 1</ambient><diffuse>0.82 0.78 0.72 1</diffuse></material>
        </visual>
      </link>
      <link name="bedroom_divider_west">
        <pose>-6.55 0 1.3 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.9 0.14 2.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.9 0.14 2.6</size></box></geometry>
          <material><ambient>0.72 0.69 0.65 1</ambient><diffuse>0.82 0.78 0.72 1</diffuse></material>
        </visual>
      </link>

      <!-- Hall / east living area, open at the entry and living-room door. -->
      <link name="hall_east_north">
        <pose>1 3.6 1.3 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.14 2.8 2.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.14 2.8 2.6</size></box></geometry>
          <material><ambient>0.68 0.72 0.74 1</ambient><diffuse>0.76 0.80 0.81 1</diffuse></material>
        </visual>
      </link>
      <link name="hall_east_center">
        <pose>1 0 1.3 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.14 2.0 2.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.14 2.0 2.6</size></box></geometry>
          <material><ambient>0.68 0.72 0.74 1</ambient><diffuse>0.76 0.80 0.81 1</diffuse></material>
        </visual>
      </link>

      <!-- Bathroom in the southeast corner, with a west-facing doorway. -->
      <link name="bathroom_north">
        <pose>2.5 -2.1 1.3 0 0 0</pose>
        <collision name="collision"><geometry><box><size>3.0 0.14 2.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>3.0 0.14 2.6</size></box></geometry>
          <material><ambient>0.70 0.76 0.78 1</ambient><diffuse>0.80 0.87 0.89 1</diffuse></material>
        </visual>
      </link>
      <link name="bathroom_east">
        <pose>4 -3.55 1.3 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.14 2.9 2.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.14 2.9 2.6</size></box></geometry>
          <material><ambient>0.70 0.76 0.78 1</ambient><diffuse>0.80 0.87 0.89 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Floor accents make room boundaries legible to people without adding
         collision seams under the robot. -->
    <model name="floor_accents">
      <static>true</static>
      <!-- Reads the exterior portion of the floor slab as paving rather than
           interior flooring. Visual only, so the doorway stays seamless. -->
      <link name="entry_apron">
        <pose>0 -6.5 0.006 0 0 0</pose>
        <visual name="visual">
          <geometry><box><size>14 3 0.012</size></box></geometry>
          <material><ambient>0.40 0.40 0.42 1</ambient><diffuse>0.52 0.52 0.54 1</diffuse></material>
        </visual>
      </link>
      <link name="entry_walk">
        <pose>0 -6.4 0.014 0 0 0</pose>
        <visual name="visual">
          <geometry><box><size>1.8 2.8 0.008</size></box></geometry>
          <material><ambient>0.56 0.54 0.50 1</ambient><diffuse>0.70 0.68 0.62 1</diffuse></material>
        </visual>
      </link>
      <link name="living_rug">
        <pose>4 0.2 0.006 0 0 0</pose>
        <visual name="visual">
          <geometry><box><size>3.5 2.4 0.012</size></box></geometry>
          <material><ambient>0.16 0.24 0.32 1</ambient><diffuse>0.22 0.34 0.44 1</diffuse></material>
        </visual>
      </link>
      <link name="kitchen_floor">
        <pose>4.3 3.8 0.007 0 0 0</pose>
        <visual name="visual">
          <geometry><box><size>5.2 2.0 0.014</size></box></geometry>
          <material><ambient>0.58 0.59 0.58 1</ambient><diffuse>0.70 0.71 0.69 1</diffuse></material>
        </visual>
      </link>
      <link name="bathroom_floor">
        <pose>2.5 -3.55 0.008 0 0 0</pose>
        <visual name="visual">
          <geometry><box><size>2.85 2.75 0.016</size></box></geometry>
          <material><ambient>0.45 0.56 0.60 1</ambient><diffuse>0.58 0.70 0.74 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="living_room_sofa">
      <static>true</static>
      <pose>5.6 0.3 0 0 0 1.57079632679</pose>
      <link name="seat">
        <pose>0 0 0.38 0 0 0</pose>
        <collision name="collision"><geometry><box><size>2.2 0.82 0.38</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.2 0.82 0.38</size></box></geometry>
          <material><ambient>0.14 0.20 0.28 1</ambient><diffuse>0.20 0.30 0.42 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
        </visual>
      </link>
      <link name="back">
        <pose>0 0.34 0.78 0 0 0</pose>
        <collision name="collision"><geometry><box><size>2.2 0.14 0.75</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.2 0.14 0.75</size></box></geometry>
          <material><ambient>0.14 0.20 0.28 1</ambient><diffuse>0.20 0.30 0.42 1</diffuse></material>
        </visual>
      </link>
      <link name="arm_left">
        <pose>-1.02 0 0.58 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.16 0.84 0.54</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.16 0.84 0.54</size></box></geometry><material><diffuse>0.20 0.30 0.42 1</diffuse></material></visual>
      </link>
      <link name="arm_right">
        <pose>1.02 0 0.58 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.16 0.84 0.54</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.16 0.84 0.54</size></box></geometry><material><diffuse>0.20 0.30 0.42 1</diffuse></material></visual>
      </link>
    </model>

    <model name="coffee_table">
      <static>true</static>
      <pose>4.0 0.2 0 0 0 0</pose>
      <link name="table">
        <collision name="top_collision"><pose>0 0 0.43 0 0 0</pose><geometry><box><size>1.35 0.72 0.10</size></box></geometry></collision>
        <visual name="top"><pose>0 0 0.43 0 0 0</pose><geometry><box><size>1.35 0.72 0.10</size></box></geometry><material><diffuse>0.48 0.30 0.17 1</diffuse><specular>0.16 0.16 0.16 1</specular></material></visual>
        <visual name="leg_left"><pose>-0.52 0 0.22 0 0 0</pose><geometry><box><size>0.10 0.55 0.42</size></box></geometry><material><diffuse>0.30 0.18 0.10 1</diffuse></material></visual>
        <visual name="leg_right"><pose>0.52 0 0.22 0 0 0</pose><geometry><box><size>0.10 0.55 0.42</size></box></geometry><material><diffuse>0.30 0.18 0.10 1</diffuse></material></visual>
      </link>
    </model>

    <model name="media_console">
      <static>true</static>
      <pose>2.1 0.4 0 0 0 1.57079632679</pose>
      <link name="console">
        <collision name="collision"><pose>0 0 0.35 0 0 0</pose><geometry><box><size>1.6 0.38 0.7</size></box></geometry></collision>
        <visual name="cabinet"><pose>0 0 0.35 0 0 0</pose><geometry><box><size>1.6 0.38 0.7</size></box></geometry><material><diffuse>0.18 0.18 0.19 1</diffuse></material></visual>
        <visual name="screen"><pose>0 0.03 1.02 0 0 0</pose><geometry><box><size>1.35 0.08 0.75</size></box></geometry><material><diffuse>0.02 0.03 0.04 1</diffuse><specular>0.35 0.35 0.35 1</specular></material></visual>
      </link>
    </model>

    <model name="kitchen_counters">
      <static>true</static>
      <link name="north_counter">
        <pose>4.7 4.55 0.46 0 0 0</pose>
        <collision name="collision"><geometry><box><size>4.2 0.72 0.92</size></box></geometry></collision>
        <visual name="base"><geometry><box><size>4.2 0.72 0.92</size></box></geometry><material><diffuse>0.70 0.72 0.70 1</diffuse></material></visual>
        <visual name="worktop"><pose>0 0 0.49 0 0 0</pose><geometry><box><size>4.3 0.78 0.07</size></box></geometry><material><diffuse>0.18 0.20 0.22 1</diffuse><specular>0.22 0.22 0.22 1</specular></material></visual>
      </link>
      <link name="east_counter">
        <pose>6.55 3.25 0.46 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.72 1.9 0.92</size></box></geometry></collision>
        <visual name="base"><geometry><box><size>0.72 1.9 0.92</size></box></geometry><material><diffuse>0.70 0.72 0.70 1</diffuse></material></visual>
        <visual name="worktop"><pose>0 0 0.49 0 0 0</pose><geometry><box><size>0.78 2.0 0.07</size></box></geometry><material><diffuse>0.18 0.20 0.22 1</diffuse></material></visual>
      </link>
      <link name="island">
        <pose>4.3 3.05 0.46 0 0 0</pose>
        <collision name="collision"><geometry><box><size>1.7 0.78 0.92</size></box></geometry></collision>
        <visual name="base"><geometry><box><size>1.7 0.78 0.92</size></box></geometry><material><diffuse>0.28 0.38 0.42 1</diffuse></material></visual>
        <visual name="worktop"><pose>0 0 0.49 0 0 0</pose><geometry><box><size>1.85 0.9 0.07</size></box></geometry><material><diffuse>0.75 0.75 0.72 1</diffuse><specular>0.18 0.18 0.18 1</specular></material></visual>
      </link>
    </model>

    <model name="dining_table">
      <static>true</static>
      <pose>2.15 3.65 0 0 0 1.57079632679</pose>
      <link name="table">
        <collision name="collision"><pose>0 0 0.74 0 0 0</pose><geometry><box><size>1.6 0.85 0.10</size></box></geometry></collision>
        <visual name="top"><pose>0 0 0.74 0 0 0</pose><geometry><box><size>1.6 0.85 0.10</size></box></geometry><material><diffuse>0.44 0.27 0.14 1</diffuse></material></visual>
        <visual name="pedestal"><pose>0 0 0.37 0 0 0</pose><geometry><cylinder><radius>0.11</radius><length>0.7</length></cylinder></geometry><material><diffuse>0.20 0.20 0.21 1</diffuse></material></visual>
        <visual name="base"><pose>0 0 0.05 0 0 0</pose><geometry><cylinder><radius>0.38</radius><length>0.08</length></cylinder></geometry><material><diffuse>0.20 0.20 0.21 1</diffuse></material></visual>
      </link>
    </model>

    <model name="north_bed">
      <static>true</static>
      <pose>-4.8 3.25 0 0 0 0</pose>
      <link name="bed">
        <collision name="collision"><pose>0 0 0.34 0 0 0</pose><geometry><box><size>2.05 1.45 0.68</size></box></geometry></collision>
        <visual name="frame"><pose>0 0 0.20 0 0 0</pose><geometry><box><size>2.15 1.55 0.40</size></box></geometry><material><diffuse>0.32 0.20 0.12 1</diffuse></material></visual>
        <visual name="mattress"><pose>0 0 0.50 0 0 0</pose><geometry><box><size>2.0 1.42 0.24</size></box></geometry><material><diffuse>0.84 0.83 0.76 1</diffuse></material></visual>
        <visual name="blanket"><pose>0.35 0 0.635 0 0 0</pose><geometry><box><size>1.25 1.38 0.05</size></box></geometry><material><diffuse>0.26 0.38 0.56 1</diffuse></material></visual>
        <visual name="headboard"><pose>-1.0 0 0.76 0 0 0</pose><geometry><box><size>0.12 1.55 1.05</size></box></geometry><material><diffuse>0.32 0.20 0.12 1</diffuse></material></visual>
      </link>
    </model>

    <model name="south_bed">
      <static>true</static>
      <pose>-4.8 -3.15 0 0 0 0</pose>
      <link name="bed">
        <collision name="collision"><pose>0 0 0.34 0 0 0</pose><geometry><box><size>2.05 1.45 0.68</size></box></geometry></collision>
        <visual name="frame"><pose>0 0 0.20 0 0 0</pose><geometry><box><size>2.15 1.55 0.40</size></box></geometry><material><diffuse>0.30 0.22 0.16 1</diffuse></material></visual>
        <visual name="mattress"><pose>0 0 0.50 0 0 0</pose><geometry><box><size>2.0 1.42 0.24</size></box></geometry><material><diffuse>0.86 0.84 0.78 1</diffuse></material></visual>
        <visual name="blanket"><pose>0.35 0 0.635 0 0 0</pose><geometry><box><size>1.25 1.38 0.05</size></box></geometry><material><diffuse>0.47 0.28 0.34 1</diffuse></material></visual>
        <visual name="headboard"><pose>-1.0 0 0.76 0 0 0</pose><geometry><box><size>0.12 1.55 1.05</size></box></geometry><material><diffuse>0.30 0.22 0.16 1</diffuse></material></visual>
      </link>
    </model>

    <model name="bedroom_storage">
      <static>true</static>
      <link name="north_wardrobe">
        <pose>-6.45 1.1 1.0 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.8 1.5 2.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.8 1.5 2.0</size></box></geometry><material><diffuse>0.55 0.43 0.32 1</diffuse></material></visual>
      </link>
      <link name="south_wardrobe">
        <pose>-6.45 -1.1 1.0 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.8 1.5 2.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.8 1.5 2.0</size></box></geometry><material><diffuse>0.50 0.39 0.30 1</diffuse></material></visual>
      </link>
    </model>

    <model name="bathroom_fixtures">
      <static>true</static>
      <link name="tub">
        <pose>3.35 -3.55 0.30 0 0 0</pose>
        <collision name="collision"><geometry><box><size>1.05 1.75 0.60</size></box></geometry></collision>
        <visual name="outer"><geometry><box><size>1.05 1.75 0.60</size></box></geometry><material><diffuse>0.88 0.90 0.91 1</diffuse><specular>0.20 0.20 0.20 1</specular></material></visual>
        <visual name="basin"><pose>0 0 0.16 0 0 0</pose><geometry><box><size>0.76 1.45 0.32</size></box></geometry><material><diffuse>0.45 0.65 0.72 1</diffuse></material></visual>
      </link>
