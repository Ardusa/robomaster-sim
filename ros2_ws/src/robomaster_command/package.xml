<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robomaster_command</name>
  <version>0.0.1</version>
  <description>Natural-language command grounding and execution for the RoboMaster EP.

    Converts a prompt into an ActionPrimitive sequence, then drives Nav2 via
    robomaster_drivetrain and robomaster_arm action servers. Does not publish
    cmd_vel directly.
  </description>
  <maintainer email="ardusa05@gmail.com">Ankur</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>action_msgs</depend>
  <depend>robomaster_arm</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>robomaster_drivetrain</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>robomaster_gazebo</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
