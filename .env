ROBOMASTER_IP=192.168.2.1
SIM=true

# robot_only.sdf | modern_house.sdf
WORLD=modern_house.sdf

# Gazebo GUI window. The dashboard (:8090) is the normal way to watch the sim,
# so this defaults off. true only works where a display exists (WSL2/Linux);
# Mac and Windows are always headless regardless.
GUI=false
